{
  "mirrors": {
    "sources": [
      "tools/*.sh",
      "scripts/*.sh",
      "tests/helpers/*.mjs",
      "tests/e2e/lib/*.mjs",
      "tests/e2e/measure.mjs",
      "Chrome/*.js",
      "Firefox/*.js",
      "Common/content_iframe.js",
      "Common/content.js",
      "Common/components/shared.js",
      "Common/components/popups.js",
      "Common/components/ui.js",
      "Common/components/global.js"
    ],
    "exclude": [
      "scripts/owner/*"

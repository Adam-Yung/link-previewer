{
  "name": "link-previewer",
  "version": "2.4.0",
  "description": "Preview links in a popup without leaving your current page",
  "private": true,
  "scripts": {
    "build": "./tools/build.sh",
    "clean": "./tools/build.sh clean",
    "test": "node --test 'tests/unit/*.test.mjs'",
    "e2e": "node --test --test-concurrency=1 --test-timeout=60000 'tests/e2e/*.test.mjs'",
    "e2e:firefox": "node tests/e2e/firefox-smoke.mjs",
    "verify": "./scripts/verify.sh"
  },
  "devDependencies": {
    "eslint": "10.13.0"
  }
}
